            <ShowObjectiveText>
              <IsNotTriggered>CensorUsed</IsNotTriggered>
              <Mapname>Agora-gate</Mapname>
              <ID>43164662</ID>
            </ShowObjectiveText>
          </ShowObjectiveTexts>
        </Objective>
      </Objectives>
    </ObjectivePack>
    
    <ObjectivePack>
      <ID>29</ID>
      <Section>Zeus</Section>
      <MainLevel>Zeus-hub</MainLevel>
      <OnTrigger>Zeus-hub</OnTrigger>
      <AddFoundDoor>Zeus</AddFoundDoor>
      <FinalArea>true</FinalArea>
      <Objectives>
        <Objective>
          <ID>57</ID>
          <Description>Defeat Zeus</Description>
          <OffTrigger>ZeusDead</OffTrigger>
          <ShowObjectiveTexts>
            <ShowObjectiveText>
              <Mapname>Zeus-hub</Mapname>
              <LevelDoor>Zeus-palace</LevelDoor>
            </ShowObjectiveText>
            <ShowObjectiveText>
              <Mapname>Zeus-hera</Mapname>
              <LevelDoor>Zeus-hub</LevelDoor>
            </ShowObjectiveText>
          </ShowObjectiveTexts>
        </Objective>
      </Objectives>
    </ObjectivePack>
    
    <ObjectivePack>
      <ID>200</ID>
      <OnTrigger>ExitZeus</OnTrigger>
      <Objectives>
        <Objective>
          <ID>570</ID>
          <Description>Descend from Mount Olympus</Description>
          <NoCompletePopup>true</NoCompletePopup>
          <OffTrigger>EndVillage</OffTrigger>
          <ShowObjectiveTexts>
            <ShowObjectiveText>
              <Mapname>Zeus-palace</Mapname>
              <LevelDoor>Agora-gates</LevelDoor>
            </ShowObjectiveText>
            <ShowObjectiveText>
              <Mapname>Agora-gate</Mapname>
              <Tag>Start</Tag>
            </ShowObjectiveText>
          </ShowObjectiveTexts>
        </Objective>
      </Objectives>
      <FinalArea>true</FinalArea>
    </ObjectivePack>
    
    
  </ObjectivePacks>

