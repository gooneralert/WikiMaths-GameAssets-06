  <WorldmapSections>
    <WorldmapSection>
      <Name>Village</Name>
      <NotOnMap>true</NotOnMap>
      <GameLevel>0</GameLevel>
    </WorldmapSection>
    
    <WorldmapSection>
      <Name>Olympus Gates</Name>
      <DisplayName>Olympian Gates</DisplayName>
      <Description>High above the clouds, the gilded gates of Mount Olympus are open only to those with divine blessings. From here, one can travel throughout the City of the Gods.</Description>
      <ShrineMap>Agora-gate</ShrineMap>
      <GameLevel>2</GameLevel>
      <MapCenter>
        <X>90</X>
        <Y>826</Y>
      </MapCenter>
    </WorldmapSection>
    
    <WorldmapSection>
      <Name>Forest</Name>
      <ShrineMap>Forest</ShrineMap>

      <Description>The Wild Goddess Artemis has created a flourishing sanctuary for herself and her woodland followers, nestled amongst the peaks of Olympus. Other deities relax in the moonlit groves, or hunt wild animals no longer found on Earth. </Description>
      
      <DisplayName>Forest of Artemis</DisplayName>
      <TotalLockboxes>8</TotalLockboxes>
      <MapCenter>
        <X>402</X>
        <Y>610</Y>
      </MapCenter>
      <GameLevel>1</GameLevel>
      <Symbols>
        <string>sym-artemisbow</string>
      </Symbols>
    </WorldmapSection>
    
    <WorldmapSection>
      <Name>Agora</Name>
      <TotalLockboxes>11</TotalLockboxes>
      <Description>The central gathering place of commerce and assembly on Olympus. Many displaced deities have taken up residence in the twisting streets and lofty houses.</Description>

      <ShrineMap>Agora</ShrineMap>
      <DisplayName>The Agora</DisplayName>
      <MapCenter>
        <X>765</X>
        <Y>720</Y>
      </MapCenter>
      <GameLevel>2</GameLevel>
      <Symbols>
        <string>sym-aproditecestus</string>
        <string>sym-dionysus</string>
      </Symbols>
    </WorldmapSection>
    
    <WorldmapSection>
      <Name>Hades</Name>
      <ShrineMap>Hades</ShrineMap>
      <DisplayName>Hades Underworld</DisplayName>
      <TotalLockboxes>6</TotalLockboxes>
      
      <Description>Deep below the Earth, Hades, Lord of the Dead, rules over his ever growing kingdom. The five Rivers, Agony, Hatred, Sorrow, Oblivion, and Fire, encircle his throne, and spell doom for mortal intruders.</Description>
      
      <MapCenter>
        <X>898</X>
        <Y>966</Y>
      </MapCenter>
      <GameLevel>3</GameLevel>
      <Symbols>
        <string>sym-demetersheaf</string>
      </Symbols>
    </WorldmapSection>
    
    
    <WorldmapSection>
      <Name>Apollo</Name>
      <ShrineMap>Apollo</ShrineMap>
      <DisplayName>Palace of Apollo</DisplayName>
      <TotalLockboxes>9</TotalLockboxes>
      
      <Description>In the luxurious halls of his marble palace, the Sun God Apollo holds extravagant symphonies for musicians and artists, the social elite of Olympus.</Description>
      
      <MapCenter>
        <X>1048</X>
        <Y>596</Y>
      </MapCenter>
      <GameLevel>4</GameLevel>
      <Symbols>
        <string>sym-apollolyre</string>
      </Symbols>
    </WorldmapSection>
    
    
    <WorldmapSection>
      <Name>VillageAct2</Name>
      <NotOnMap>true</NotOnMap>
      <GameLevel>5</GameLevel>
    </WorldmapSection>
    <WorldmapSection>
      <Name>VillageAct3</Name>
      <NotOnMap>true</NotOnMap>
      <GameLevel>5</GameLevel>
    </WorldmapSection>
    <WorldmapSection>
      <Name>VillageZeus</Name>
      <NotOnMap>true</NotOnMap>
      <GameLevel>5</GameLevel>
    </WorldmapSection>
    <WorldmapSection>
      <Name>VillageEnd</Name>
      <NotOnMap>true</NotOnMap>
      <GameLevel>5</GameLevel>
    </WorldmapSection>
    
    
    <WorldmapSection>
      <Name>Acropolis</Name>
      <TotalLockboxes>12</TotalLockboxes>
      <DisplayName>The Acropolis</DisplayName>
      <Description>High upon Olympus, those favored by Zeus reside in decadent palaces and temples. Here, they comfortably wait out the storm of the Gods, until it is safe to return to their sanctuaries on Earth.</Description>
      <GameLevel>6</GameLevel>
      <Symbols>
        <string>sym-hephaestus</string>
        <string>sym-hermes</string>
      </Symbols>
      <ShrineMap>Acropolis</ShrineMap>
      <MapCenter>
        <X>683</X>
        <Y>288</Y>
      </MapCenter>
    </WorldmapSection>
    
    
    <WorldmapSection>
      <Name>Ares</Name>
      <DisplayName>Agon of Ares</DisplayName>
      <GameLevel>7</GameLevel>
      <Description>Awash with bloodshed and the din of battle, Ares, God of War, pits heroes and cowards against one another in his personal arena. Those who have incurred his wrath are imprisoned forever to fight for his sadistic entertainment.</Description>
      <TotalLockboxes>3</TotalLockboxes>
      <ShrineMap>Ares</ShrineMap>
      <Symbols>
        <string>sym-ares</string>
      </Symbols>
      <MapCenter>
        <X>871</X>
        <Y>438</Y>
      </MapCenter>
    </WorldmapSection>
    
    <WorldmapSection>
      <Name>Sea</Name>
      <DisplayName>The Sea</DisplayName>
      <GameLevel>8</GameLevel>
      <Description>The turbulent waters surrounding Olympus are sacred to Poseidon, Lord of the Sea. Amongst the rocky islands that dot the waves, monuments to his greatness can be found.</Description>
      <TotalLockboxes>14</TotalLockboxes>
      <ShrineMap>Sea-hub</ShrineMap>
      <Symbols>
        <string>sym-poseidon</string>
      </Symbols>
      <MapCenter>
        <X>53</X>
        <Y>338</Y>
      </MapCenter>
    </WorldmapSection>
    
    <WorldmapSection>
      <Name>Athena</Name>
      <DisplayName>Refuge of Athena</DisplayName>
      <TotalLockboxes>8</TotalLockboxes>
      <GameLevel>9</GameLevel>
      <Description>Mysterious and foreboding, the halls of Athena the Wise are constantly shifting and rebuilding themselves to suit her ever changing stratagems. Those who enter find themselves trapped under the shadow of a vastly superior mind.</Description>
      <ShrineMap>Athena</ShrineMap>
      <Symbols>
        <string>sym-athena</string>
      </Symbols>
      <MapCenter>
        <X>1061</X>
        <Y>180</Y>
      </MapCenter>
    </WorldmapSection>
    
    <WorldmapSection>
      <Name>Zeus</Name>
      <GameLevel>10</GameLevel>
      <Description>Held aloft by raging stormclouds and typhoon winds, the citadel of Zeus, King of the Gods, looms high over Mount Olympus. From his mighty throne, the Lord of Thunder surveys his vast dominion, and passes judgement on those deemed unworthy.</Description>
      <TotalLockboxes>4</TotalLockboxes>
      <DisplayName>Fortress of Zeus</DisplayName>
      <ShrineMap>Zeus-hub</ShrineMap>
      <Symbols>
        <string>sym-hera</string>
        <string>sym-zeus</string>
      </Symbols>
      <MapCenter>
        <X>736</X>
        <Y>30</Y>
      </MapCenter>
