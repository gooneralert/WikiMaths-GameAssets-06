          <HelpText>Bring Daphne Water</HelpText>
          <ShowObjectiveTexts>
            <ShowObjectiveText>
              <Mapname>Apollo</Mapname>
              <LevelDoor>Apollo-garden</LevelDoor>
            </ShowObjectiveText> <!--
            <ShowObjectiveText>
              <Mapname>Apollo-garden</Mapname>
              <Entities>
                <int>30479771</int>
              </Entities>
            </ShowObjectiveText> -->
           </ShowObjectiveTexts>
        </Objective>
        
        <Objective><ID>25</ID>
