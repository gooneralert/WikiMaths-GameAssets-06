</MultiplayerSettings>␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀Content/Settings/Objectives.xml␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀0000755␀0001750␀0001750␀00000131201␀15157063035␀016745␀ 0␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀ustar  ␀collinc␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀collinc␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀<?xml version="1.0"?>
<ObjectivesSettings xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">

  <ObjectivePacks>

    <!-- ********************************************************************  -->
    <!-- VILLAGE LEVEL  -->
    <ObjectivePack>
      <ID>1</ID>
      <Section>Village</Section>
      <MainLevel>village-act1</MainLevel>
      <OnTrigger>obj-village</OnTrigger>
      <!--<MainLevelDescription>Secure the Village</MainLevelDescription> -->
      <CompletedEvent>
        <AddWorldTrigger>objpack-village village-temple-door</AddWorldTrigger>
        <ConsoleMessageObjectiveText>All objectives complete</ConsoleMessageObjectiveText>
      </CompletedEvent>
      <Objectives>
        <Objective>
          <ID>1</ID>
          <Description>Rescue the Prisoners</Description>
          <OffTrigger>obj-captivesfreed</OffTrigger>
          <DisplayTextIfTriggered>village-act1-boat</DisplayTextIfTriggered>
          <OnCompleteEvent>
            <AddWorldTrigger>village-AllowLockpicks</AddWorldTrigger>
            <TriggeredMusic>GazeOfAres_Ambient</TriggeredMusic>
          </OnCompleteEvent>
          <ShowObjectiveTexts>
            <ShowObjectiveText>
              <Mapname>village-act1</Mapname>
              <LevelDoor>village-act1-boat</LevelDoor>
            </ShowObjectiveText>
          </ShowObjectiveTexts>
        </Objective>
        <Objective>
          <ID>2</ID>
          <Description>Find the Blacksmith</Description>
          <OffTrigger>obj-blacksmith</OffTrigger>
          <DisplayTextIfTriggered>village-act1-blacksmith</DisplayTextIfTriggered>
          <OnCompleteEvent>
            <AddWorldTrigger>village-AllowArmor</AddWorldTrigger>
            <TriggeredMusic>GazeOfAres_Ambient</TriggeredMusic>
          </OnCompleteEvent>
          <ShowObjectiveTexts>
            <ShowObjectiveText>
              <Mapname>village-act1</Mapname>
              <LevelDoor>village-act1-blacksmith</LevelDoor>
            </ShowObjectiveText>
          </ShowObjectiveTexts>
        </Objective>
        <Objective>
          <ID>3</ID>
          <Description>Secure the Granary</Description>
          <OffTrigger>AllRaidersKilled</OffTrigger>
          <DisplayTextIfTriggered>village-act1-market</DisplayTextIfTriggered>
          <OnCompleteEvent>
            <TriggeredMusic>GazeOfAres_Ambient</TriggeredMusic>
          </OnCompleteEvent>
          <ShowObjectiveTexts>
            <ShowObjectiveText>
              <Mapname>village-act1</Mapname>
              <LevelDoor>village-act1-market</LevelDoor>
            </ShowObjectiveText>
          </ShowObjectiveTexts>
        </Objective>
        <Objective>
          <ID>4</ID>
          <Description>Find the Apothecary</Description>
          <OffTrigger>obj-philosoper</OffTrigger>
          <DisplayTextIfTriggered>village-act1-academe</DisplayTextIfTriggered>
          <OnCompleteEvent>
            <AddWorldTrigger>village-AllowPotion</AddWorldTrigger>
            <TriggeredMusic>GazeOfAres_Ambient</TriggeredMusic>
          </OnCompleteEvent>
          <ShowObjectiveTexts>
            <ShowObjectiveText>
              <Mapname>village-act1</Mapname>
              <LevelDoor>village-act1-academe</LevelDoor>
            </ShowObjectiveText>
          </ShowObjectiveTexts>
        </Objective>
        <Objective>
          <ID>5</ID>
          <Description>Find the Hunter</Description>
          <OffTrigger>obj-hunter</OffTrigger>
          <DisplayTextIfTriggered>village-act1-hunter</DisplayTextIfTriggered>
          <OnCompleteEvent>
            <AddWorldTrigger>village-AllowProjectiles</AddWorldTrigger>
            <TriggeredMusic>GazeOfAres_Ambient</TriggeredMusic>
          </OnCompleteEvent>
          <ShowObjectiveTexts>
            <ShowObjectiveText>
              <Mapname>village-act1</Mapname>
              <LevelDoor>village-act1-hunter</LevelDoor>
            </ShowObjectiveText>
          </ShowObjectiveTexts>
        </Objective>
      </Objectives>
    </ObjectivePack>
    <ObjectivePack>
      <ID>2</ID>
      <Section>Village</Section>
      <MainLevel>village-act1</MainLevel>
      <OnTrigger>obj-killtyrant</OnTrigger>
      <Objectives>
        <Objective>
          <ID>6</ID>
          <Description>Defeat the Tyrant</Description>
          <OffTrigger>tyrantkilled</OffTrigger>
          <DisplayTextIfTriggered>village-act1 || village-act1-temple</DisplayTextIfTriggered>
          <ShowObjectiveTexts>
            <ShowObjectiveText>
              <Mapname>village-act1</Mapname>
              <IsNotTriggered>door-passed</IsNotTriggered>
              <NoDisplayInView>true</NoDisplayInView>
              <OnlyOneEntity>true</OnlyOneEntity>
              <Entities>
                <int>61435734</int>
                <int>28048521</int>
              </Entities>
            </ShowObjectiveText>
            <ShowObjectiveText>
              <Mapname>village-act1-temple</Mapname>
              <Entities>
                <int>24945413</int>
              </Entities>
            </ShowObjectiveText>
          </ShowObjectiveTexts>
        </Objective>
      </Objectives>
    </ObjectivePack>

    <!-- ********************************************************************  -->
    <!-- AGORA  -->
    <ObjectivePack>
      <ID>3</ID>
      <Section>Agora</Section>
      <MainLevel>Agora</MainLevel>
      <OnTrigger>obj-agora</OnTrigger>
      <AddFoundDoor>Agora</AddFoundDoor>
      <CompletedEvent>
        <Delay>3</Delay>
        <AddWorldTrigger>Act1-end</AddWorldTrigger>
        <ConsoleMessageObjectiveText>All objectives complete</ConsoleMessageObjectiveText>
      </CompletedEvent>
      <Objectives>
        <Objective>
          <ID>7</ID>
          <Description>Find the Lyre of Apollo</Description>
          <OffTrigger>ApolloLyre</OffTrigger>
          <ShowObjectiveTextsIfTriggered>apollo</ShowObjectiveTextsIfTriggered>
          <NoCompletePopup>true</NoCompletePopup>
          <ShowObjectiveTexts>
            <ShowObjectiveText>
              <Mapname>Agora</Mapname>
              <LevelDoor>Apollo</LevelDoor>
            </ShowObjectiveText>
          </ShowObjectiveTexts>
        </Objective>
        <Objective>
          <ID>8</ID>
          <NoPopUps>true</NoPopUps>
          <ShowObjectiveTextsIfTriggered>artemis</ShowObjectiveTextsIfTriggered>
          <Description>Market</Description>
          <OffTrigger>market</OffTrigger>
          <NoCompletePopup>true</NoCompletePopup>
          <ShowObjectiveTexts>
            <ShowObjectiveText>
              <Mapname>Agora</Mapname>
              <LevelDoor>Agora-market</LevelDoor>
            </ShowObjectiveText>
          </ShowObjectiveTexts>
          <NotOnWorldmap>true</NotOnWorldmap>
        </Objective>
        <Objective>
          <ID>9</ID>
          <Description>Find the Bow of Artemis</Description>
          <OffTrigger>ArtemisBow</OffTrigger>
          <ShowObjectiveTextsIfTriggered>artemis</ShowObjectiveTextsIfTriggered>
          <NoCompletePopup>true</NoCompletePopup>
          <ShowObjectiveTexts>
            <ShowObjectiveText>
              <Mapname>Agora</Mapname>
              <LevelDoor>Forest</LevelDoor>
            </ShowObjectiveText>
          </ShowObjectiveTexts>
        </Objective>
        <Objective>
          <ID>11</ID>
          <Description>Find the Sheaf of Demeter</Description>
          <OffTrigger>Demeter-Rescue</OffTrigger>
          <NotOnWorldmap>true</NotOnWorldmap>
          <ShowObjectiveTextsIfTriggered>demeter</ShowObjectiveTextsIfTriggered>
          <NoCompletePopup>true</NoCompletePopup>
          <ShowObjectiveTexts>
            <ShowObjectiveText>
              <Mapname>Agora</Mapname>
              <LevelDoor>Agora-Demeter</LevelDoor>
            </ShowObjectiveText>
          </ShowObjectiveTexts>
        </Objective>
        <Objective>
          <ID>12</ID>
          <Description>Descend to Hades</Description>
          <NotOnWorldmap>true</NotOnWorldmap>
          <ShowObjectiveTextsIfTriggered>Demeter-Rescue</ShowObjectiveTextsIfTriggered>
          <NoCompletePopup>true</NoCompletePopup>
          <OffTrigger>SwitchToHades</OffTrigger>
          <ShowObjectiveTexts>
            <ShowObjectiveText>
              <Mapname>Agora</Mapname>
              <LevelDoor>Agora-sewers</LevelDoor>
            </ShowObjectiveText>
            <ShowObjectiveText>
              <Mapname>Agora-sewers</Mapname>
              <Entities>
                <int>60714510</int>
              </Entities>
              <NoDisplayInView>true</NoDisplayInView>
            </ShowObjectiveText>
          </ShowObjectiveTexts>
        </Objective>
        <Objective>
          <ID>13</ID>
          <NoPopUps>true</NoPopUps>
          <ShowObjectiveTextsIfTriggered>RescuedPersephone</ShowObjectiveTextsIfTriggered>
          <NoCompletePopup>true</NoCompletePopup>
          <Description>Find the Sheaf of Demeter</Description>
          <OffTrigger>DemetersSheaf</OffTrigger>
          <ShowObjectiveTexts>
            <ShowObjectiveText>
              <Mapname>Agora</Mapname>
              <LevelDoor>Agora-Demeter</LevelDoor>
            </ShowObjectiveText>
          </ShowObjectiveTexts>
        </Objective>
      </Objectives>
      <FinalArea>true</FinalArea>
    </ObjectivePack>

    <!-- ********************************************************************  -->
    <!-- FOREST  -->
    <ObjectivePack>
      <!-- Since the on trigger is the levelname, this is given as soon as the player enters the level, and focuses on the npymh-->
      <ID>4</ID>
      <Section>Forest</Section>
      <MainLevel>Forest</MainLevel>
      <OnTrigger>Forest</OnTrigger>
      <NoPopUps>true</NoPopUps>
      <Objectives>
        <Objective>
          <ID>14</ID>
          <Description>Find the Bow of Artemis</Description>
          <OffTrigger>NypmhTalk</OffTrigger>
          <DisplayTextIfTriggered>Forest</DisplayTextIfTriggered>
          <ShowObjectiveTexts>
            <ShowObjectiveText>
              <Mapname>Forest</Mapname>
              <Entities>
                <int>27765811</int>
              </Entities>
            </ShowObjectiveText>
          </ShowObjectiveTexts>
        </Objective>
      </Objectives>
    </ObjectivePack>
    
    <ObjectivePack>
      <ID>5</ID>
      <!-- Given by nypmh -->
      <Section>Forest</Section>
      <MainLevel>Forest</MainLevel>
      <OnTrigger>obj-forest</OnTrigger>
      <AddFoundDoor>Forest</AddFoundDoor>
      <CompletedEvent>
        <AddWorldTrigger>forest-nymph2</AddWorldTrigger>
      </CompletedEvent>
      <Objectives>
        <Objective>
          <ID>15</ID>
          <Description>Hunt the Direwolf</Description>
          <OffTrigger>DIREWOLFDEAD</OffTrigger>
          <ShowObjectiveTexts>
            <ShowObjectiveText>
              <NoDisplayInView>true</NoDisplayInView>
              <Mapname>Forest</Mapname>
              <Entities>
                <int>36452221</int>
              </Entities>
            </ShowObjectiveText>
          </ShowObjectiveTexts>
        </Objective>
        <Objective>
          <ID>16</ID>
          <Description>Defeat the Chimera</Description>
          <OffTrigger>HYDRA_KILLED</OffTrigger>
          <HelpText>Follow the acid trail to find the Chimera</HelpText>
          <HelpTextOffTrigger>ChimeraStartAttack</HelpTextOffTrigger>
          <DisplayTextIfTriggered>Forest-caves</DisplayTextIfTriggered>
          <ShowObjectiveTexts>
            <ShowObjectiveText>
              <Mapname>Forest</Mapname>
              <LevelDoor>Forest-caves</LevelDoor>
            </ShowObjectiveText>
            <ShowObjectiveText>
              <NoDisplayInView>true</NoDisplayInView>
              <Mapname>Forest-caves</Mapname>
              <Classfile>forest\chimera</Classfile>
            </ShowObjectiveText>
          </ShowObjectiveTexts>
        </Objective>
        <Objective>
          <ID>17</ID>
          <Description>Cleanse the Sanctuary</Description>
          <OffTrigger>satyr-fight</OffTrigger>
          <DisplayTextIfTriggered>Forest-temple</DisplayTextIfTriggered>
          <HelpTextTrigger>satyr-talked</HelpTextTrigger>
          <HelpText>Break Satyr's wine</HelpText>
          <ShowObjectiveTexts>
            <ShowObjectiveText>
              <Mapname>Forest</Mapname>
              <LevelDoor>Forest-temple</LevelDoor>
            </ShowObjectiveText>
            <ShowObjectiveText>
              <IsTriggered>satyr-talked</IsTriggered>
              <Mapname>Forest-temple</Mapname>
              <Classfile>Containers\pot-wine</Classfile>
              <NoText>true</NoText>
            </ShowObjectiveText>
          </ShowObjectiveTexts>
        </Objective>
      </Objectives>
    </ObjectivePack>

    <ObjectivePack>
      <ID>6</ID>
      <!-- Go talk to Nypmh -->
      <Section>Forest</Section>
      <MainLevel>Forest</MainLevel>
      <OnTrigger>forest-nymph2</OnTrigger>
      <NoPopUps>true</NoPopUps>
      <Objectives>
        <Objective>
          <ID>18</ID>
          <Description>Find the Nymphs</Description>
          <OffTrigger>Nypmh2Talk</OffTrigger>
          <DisplayTextIfTriggered>Forest</DisplayTextIfTriggered>
          <ShowObjectiveTexts>
            <ShowObjectiveText>
              <Mapname>Forest</Mapname>
              <Classfile>forest\nymph2</Classfile>
            </ShowObjectiveText>
          </ShowObjectiveTexts>
        </Objective>
      </Objectives>
    </ObjectivePack>
    
    <ObjectivePack>
      <ID>7</ID>
      <!-- Go to Artemis grove objective - point to the right door in the Forest, and point to exit doors when in temple / caves -->
      <Section>Forest</Section>
      <MainLevel>Forest</MainLevel>
      <OnTrigger>obj-forest-art</OnTrigger>
      <Objectives>
        <Objective><ID>19</ID>
          <Description>Find the Bow of Artemis</Description>
          <OffTrigger>Artemis-Dead</OffTrigger>
          <DisplayTextIfTriggered>Forest-grove</DisplayTextIfTriggered>
          <ShowObjectiveTexts>
            <ShowObjectiveText>
              <Mapname>Forest-grove</Mapname>
              <IsNotTriggered>killplayer</IsNotTriggered>
              <Classfile>forest\artemis</Classfile>
              <NoDisplayInView>true</NoDisplayInView>
            </ShowObjectiveText>
            <ShowObjectiveText>
              <Mapname>Forest</Mapname>
              <LevelDoor>Forest-grove</LevelDoor>
            </ShowObjectiveText>
            <ShowObjectiveText>
              <Mapname>Forest-temple</Mapname>
              <LevelDoor>Forest</LevelDoor>
            </ShowObjectiveText>
            <ShowObjectiveText>
              <Mapname>Forest-caves</Mapname>
              <LevelDoor>Forest</LevelDoor>
            </ShowObjectiveText>
          </ShowObjectiveTexts>
        </Objective>
      </Objectives>
      <FinalArea>true</FinalArea>
    </ObjectivePack>

    <!-- ********************************************************************  -->
    <!-- APOLLO  -->
    <ObjectivePack>
      <ID>9</ID>
      <!-- Since the on trigger is the levelname, this is given as soon as the player enters the level -->
      <Section>Apollo</Section>
      <MainLevel>Apollo</MainLevel>
      <OnTrigger>Apollo</OnTrigger>
      <NoPopUps>true</NoPopUps>
      <Objectives>
        <Objective><ID>21</ID>
          <Description>Find the Lyre of Apollo</Description>
          <OffTrigger>Apollo-Look</OffTrigger>
          <DisplayTextIfTriggered>Apollo</DisplayTextIfTriggered>
        </Objective>
      </Objectives>
    </ObjectivePack>
    
    <ObjectivePack>
      <ID>10</ID>
      <Section>Apollo</Section>
      <MainLevel>Apollo-dungeon</MainLevel>
      <OnTrigger>Apollo-dungeon-obj</OnTrigger>
      <Objectives>
        <Objective><ID>22</ID>
          <Description>Escape the Dungeon</Description>
          <OffTrigger>Dungeon-leave</OffTrigger>
          <DisplayTextIfTriggered>Apollo-dungeon</DisplayTextIfTriggered>
          <ShowObjectiveTexts>
            <ShowObjectiveText>
              <Mapname>Apollo-dungeon</Mapname>
              <LevelDoor>Apollo</LevelDoor>
            </ShowObjectiveText>
          </ShowObjectiveTexts>
        </Objective>
        <Objective><ID>23</ID>
          <Description>Retrieve your Items</Description>
          <OffTrigger>Dungeon-items</OffTrigger>
          <ShowObjectiveTexts>
            <ShowObjectiveText>
              <Mapname>Apollo-dungeon</Mapname>
              <Entities>
                <int>41381104</int>
              </Entities>
            </ShowObjectiveText>
          </ShowObjectiveTexts>
        </Objective>
      </Objectives>
    </ObjectivePack>
    
    <ObjectivePack>
      <ID>11</ID>
      <Section>Apollo</Section>
      <MainLevel>Apollo</MainLevel>
      <OnTrigger>Apollo-obj</OnTrigger>
      <AddFoundDoor>Apollo</AddFoundDoor>
      <CompletedEvent>
        <SecondEvent>
          <Delay>4</Delay>
          <AddWorldTrigger>Apollo-obj-boss</AddWorldTrigger>
        </SecondEvent>
      </CompletedEvent>
      <Objectives>
        
        <Objective><ID>24</ID>
          <Description>Find Daphne</Description>
